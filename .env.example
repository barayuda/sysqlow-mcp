# ============================================================================
# sysqlow-mcp — Environment Configuration
# ============================================================================
# Copy this file to `.env` and fill in the values you need. Every variable is
# optional unless explicitly marked Required. The server picks sensible
# defaults when a value is omitted.
#
# Three deployment shapes are supported — pick the section that matches your
# host, fill those variables, leave the rest blank.
# ============================================================================


# ─── 1. Database mode ───────────────────────────────────────────────────────
#
# Pick exactly one of A / B / C. Mixing them produces predictable results
# (the precedence is documented in src/db.ts) but it's clearer to commit to one.
#
# A. Local-only SQLite (no Turso account needed)
#    Leave all DB vars blank. The server uses a single file at ./sysqlow.db
#    (or LOCAL_DB_PATH if you override it). Best for offline dev and CI.
#
# B. Embedded-replica sync (recommended for laptops + persistent-disk hosts)
#    Set TURSO_DATABASE_URL to your libsql:// URL and TURSO_AUTH_TOKEN to its
#    token. The server keeps a local SQLite cache and syncs to Turso every 60s
#    in the background. Reads are microsecond-local, writes hit local + queue
#    for sync. This is what `run-docker.sh` uses by default.
#
# C. Remote-only (Render free, Fly without volumes, any ephemeral disk)
#    Set TURSO_DATABASE_URL + TURSO_AUTH_TOKEN *and* SYSQLOW_DB_REMOTE_ONLY=1.
#    No local file is created; every query is a network round-trip to Turso.
#    Slower per-query but survives container restarts on hosts with no
#    persistent disk. See docs/deploying-to-render.md.
#

# Turso cloud database URL. Required for modes B and C.
# Format: libsql://<db-name>-<org>.turso.io  (https:// also accepted)
TURSO_DATABASE_URL=""

# Auth token for the Turso database above. Required whenever
# TURSO_DATABASE_URL is set.
TURSO_AUTH_TOKEN=""

# Force direct-Turso mode (mode C). Set to "1" / "true" / "yes" to opt in.
# When enabled, the server refuses to start unless TURSO_DATABASE_URL is a
# libsql:// or https:// URL AND TURSO_AUTH_TOKEN is set — preventing a silent
# fall-back to ephemeral SQLite that would lose all knowledge on every
# container restart.
SYSQLOW_DB_REMOTE_ONLY=""

# Override the local SQLite file path (modes A and B only). Ignored when
# SYSQLOW_DB_REMOTE_ONLY=1. Default: sysqlow.db in the current directory.
# In Docker the image sets this to /app/db/sysqlow.db so a volume mount at
# /app/db gives persistent storage.
LOCAL_DB_PATH=""


# ─── 2. LLM provider (Gemini) ──────────────────────────────────────────────
#
# Gemini is the only supported LLM provider — see docs/adr/0001-gemini-only.md.
# Without GEMINI_API_KEY, Sentinel validation, embeddings, and the
# learn_codebase tool all return errors; everything else still works.
#
# Daily quota caps and the daemon reserve live in the llm_budget_config table,
# not here — tune them at runtime via the set_llm_budget MCP tool or
# /api/budget. See docs/getting-started.md for the budget guard overview.

# Required for LLM features. Get a key from https://aistudio.google.com/apikey
GEMINI_API_KEY=""


# ─── 3. Web search (Sentinel validation) ───────────────────────────────────
#
# Sentinel tries search providers in order: Tavily → SearXNG → DDG. The first
# tier with credentials configured wins; on failure it falls through to the
# next. When every tier returns empty results, Sentinel skips the LLM call
# and marks the snippet "unverifiable" instead of producing a false-positive
# "up_to_date" stamp from LLM training data alone.

# Optional. Get a key from https://tavily.com (free tier: 1,000 searches/month).
TAVILY_API_KEY=""

# Optional. Self-hosted SearXNG instance URL (e.g. http://searxng:8080).
# Most durable choice for Docker deployments — no quota, no key, runs as a
# sidecar container. Example docker-compose snippet in docs/deploying-to-render.md.
SEARXNG_URL=""

# Last-resort DDG-HTML scraper. Default "true" (enabled). Set to "false" to
# disable entirely — recommended for Docker / data-center hosts where DDG
# frequently returns ConnectionRefused on the egress IP.
SYSQLOW_DDG_FALLBACK=""


# ─── 4. Transport mode ─────────────────────────────────────────────────────
#
# stdio (default): JSON-RPC over stdin/stdout — for Claude Desktop, Cursor,
# Antigravity, and any MCP client that spawns the binary directly.
#
# sse: HTTP server with Server-Sent Events at /sse, a web dashboard at /, and
# REST endpoints at /api/*. Required for remote deployments (Render, Fly,
# Railway, etc.). Also activates the background Sentinel audit cron (12 h).

# Leave blank for stdio, set to "sse" for the HTTP/dashboard mode.
MCP_TRANSPORT=""

# HTTP port for SSE mode. Default 50741. Render/Fly inject their own PORT —
# the app reads whatever this env var contains.
PORT=""


# ─── 5. Coherence engine (project detection) ───────────────────────────────
#
# The coherence engine walks up from the MCP client's working directory to
# find a project manifest (package.json, composer.json, etc.) so it can tag
# stored knowledge with the correct project_id. Under Docker the container
# never sees the host's cwd, so run-docker.sh captures it and forwards it as
# this env var.

# Only set this manually when running the server inside a container *without*
# run-docker.sh and you want the coherence engine to attribute Project
# Context to a specific host directory. Most users can ignore this.
SYSQLOW_WORKSPACE_DIR=""


# ─── 6. Docker mount scope (run-docker.sh only) ────────────────────────────
#
# By default run-docker.sh exposes only two host paths to the container:
#   1. The sysqlow-mcp checkout itself.
#   2. The cwd you launched the script from (so the coherence engine sees
#      your current workspace).
#
# That keeps sensitive directories like ~/.ssh, ~/.aws, ~/.npmrc, and
# unrelated dotfiles unreachable from inside the container.
#
# If you jump between several project roots in one session and want all of
# them visible to the coherence engine without restarting, set this to a
# comma-separated list of absolute paths. `~` is expanded to $HOME, nested
# paths collapse to the shortest covering ancestor (so listing both
# ~/Projects and ~/Projects/foo just mounts ~/Projects), and non-existent
# entries are skipped with a warning.
#
# Examples:
#   SYSQLOW_WORKSPACE_ROOTS="~/Projects"
#   SYSQLOW_WORKSPACE_ROOTS="~/Projects,~/work,~/oss"
#
# Leave blank to keep the secure default. Has no effect outside Docker.
SYSQLOW_WORKSPACE_ROOTS=""
